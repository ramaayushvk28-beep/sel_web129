pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building project'
                bat 'mvn -f app1234/pom.xml clean compile'
            }
        }

        stage('Run Selenium Test') {
            steps {
                echo 'Running Selenium test'
                bat 'mvn -f app1234/pom.xml test'
            }
        }

    }
}
