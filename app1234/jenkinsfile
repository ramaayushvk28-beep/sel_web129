pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building project'
                dir('app1234') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Run Selenium Test') {
            steps {
                echo 'Running Selenium test'
                dir('app1234') {
                    bat 'mvn exec:java'
                }
            }
        }

    }
}
